# Copia este archivo a ".env" y rellena tus valores reales.
# Los encuentras en Supabase > Project Settings > API.

# Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# anon public key (NUNCA la service_role aqui si este .env se usa en un contexto expuesto)
SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLIC

# service_role key: SOLO para operaciones de servidor que necesiten saltarse RLS.
# Es secreta. No la subas a git ni la compartas.
SUPABASE_SERVICE_ROLE_KEY=

# URL del frontend en producción (Vercel). Se usa para CORS, la cookie de
# sesión entre dominios distintos, y para saber a dónde volver tras el login
# de Google. En local puedes dejarla sin definir (usa localhost:5173 por defecto).
FRONTEND_ORIGIN=https://tu-frontend.vercel.app
